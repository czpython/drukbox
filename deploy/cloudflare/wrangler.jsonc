{
  "name": "drukbox-sandboxes",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  // Request bodies carry Tailscale auth keys and host env.
  "observability": { "enabled": false },
  "containers": [{
    "class_name": "Sandbox",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "Dockerfile" } }
  }],
  "durable_objects": { "bindings": [{ "name": "SANDBOXES", "class_name": "Sandbox" }] },
  "exports": { "Sandbox": { "type": "durable-object", "storage": "sqlite" } }
}
