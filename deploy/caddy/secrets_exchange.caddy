# The secrets exchange, Caddy side. Import this file before the site that uses
# it, then import the snippet into the site with the exchange's address:
#
#     import /etc/caddy/secrets_exchange.caddy
#
#     secrets.example.com {
#         import secrets_exchange http://127.0.0.1:8781
#     }
#
# A sandbox sends a request for <host> to /<host>/<path> with its placeholder
# as the bearer. The exchange answers with the upstream host, the header the
# upstream reads, and the real credential; the request goes on to the upstream
# with only that header changed. Anything the exchange refuses stops here.
(secrets_exchange) {
	# Claude Code sends an unauthenticated HEAD here before every call.
	handle /api.anthropic.com/api/hello {
		respond 200
	}
	handle /* {
		route {
			forward_auth {args[0]} {
				uri /authorize
				copy_headers X-Upstream-Host X-Upstream-Header X-Upstream-Credential
			}
			uri path_regexp ^/[^/]+ ""
			request_header -Authorization
			reverse_proxy {http.request.header.X-Upstream-Host}:443 {
				header_up Host {http.request.header.X-Upstream-Host}
				header_up {http.request.header.X-Upstream-Header} {http.request.header.X-Upstream-Credential}
				header_up -X-Upstream-Host
				header_up -X-Upstream-Header
				header_up -X-Upstream-Credential
				transport http {
					tls
					tls_server_name {http.request.header.X-Upstream-Host}
				}
				flush_interval -1
			}
		}
	}
}
